# Environment variables for MLOps stack

# PostgreSQL Configuration
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_secure_password_change_me
POSTGRES_DB=mlflow

# MinIO Configuration (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# AWS Credentials for MinIO (when using MLflow locally)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_change_me

# DVC Remote Storage (optional - configure based on your setup)
# DVC_REMOTE_URL=s3://dvc-storage/sargen
# DVC_REMOTE_ACCESS_KEY_ID=your_access_key
# DVC_REMOTE_SECRET_ACCESS_KEY=your_secret_key
